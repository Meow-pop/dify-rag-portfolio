{
  "manifest_version": 3,
  "name": "星桥市场调研采集器",
  "version": "0.1.0",
  "description": "由用户触发，采集淘宝或天猫当前页面已加载的公开商品信息。",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "采集淘宝当前页",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*"
      ],
      "js": [
        "shared.js",
        "collector-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
